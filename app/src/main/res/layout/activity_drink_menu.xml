<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.activity.DrinkMenuActivity">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thực Đơn"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />

    <!-- 4 nút lọc category -->
    <LinearLayout
        android:id="@+id/filterLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCoffee"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cà phê"
            android:textColor="@color/white"
            android:backgroundTint="@color/brown"
            app:cornerRadius="12dp"
            android:layout_margin="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTea"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Trà"
            android:textColor="@color/dark_brown"
            android:backgroundTint="@color/backgroundLight"
            app:strokeColor="@color/brown"
            app:cornerRadius="12dp"
            android:layout_margin="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCake"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Bánh"
            android:textColor="@color/dark_brown"
            android:backgroundTint="@color/backgroundLight"
            app:strokeColor="@color/brown"
            app:cornerRadius="12dp"
            android:layout_margin="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOthers"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Tất cả"
            android:textColor="@color/dark_brown"
            android:backgroundTint="@color/backgroundLight"
            app:strokeColor="@color/brown"
            app:cornerRadius="12dp"
            android:layout_margin="4dp" />
    </LinearLayout>

    <!-- RecyclerView hiển thị món -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="#F5F5F5"
        app:layout_constraintTop_toBottomOf="@id/filterLayout"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_drink_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_drink_card"
        tools:ignore="MissingConstraints" />

    <!-- FAB Giỏ hàng -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddOrder1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_cart"
        app:tint="@android:color/white"
        app:backgroundTint="#D84315"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_drink_menu"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Navigation – ĐÃ SỬA DẤU ĐÓNG THẺ (/> ở cuối) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_drink_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>