<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/creamy_white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your address"
        android:textColor="@color/dark_brown"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etAddress"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="Nhập địa chỉ của bạn..."
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@drawable/bg_search_rounded"
        android:textColor="@color/dark_brown"
        android:textColorHint="@color/brownMedium"
        android:minLines="3"
        android:maxLines="5"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSelectFromMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn từ bản đồ"
        android:backgroundTint="@color/brownMedium"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy"
            android:backgroundTint="@color/backgroundLight"
            android:textColor="@color/dark_brown"
            android:layout_marginEnd="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:backgroundTint="@color/brown"
            android:textColor="@android:color/white"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

</LinearLayout>

