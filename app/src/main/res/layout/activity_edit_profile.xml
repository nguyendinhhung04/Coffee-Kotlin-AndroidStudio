<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F1"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Full name"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Phone"
            android:inputType="phone"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <EditText
            android:id="@+id/etStreet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Số nhà, đường"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <EditText
            android:id="@+id/etWard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phường/Xã"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <EditText
            android:id="@+id/etDistrict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quận/Huyện"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Thành phố/Tỉnh"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/dark_brown" />

        <CheckBox
            android:id="@+id/cbDefaultAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đặt làm địa chỉ nhận hàng mặc định"
            android:textColor="@color/dark_brown"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save"
            android:backgroundTint="@color/brown"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
