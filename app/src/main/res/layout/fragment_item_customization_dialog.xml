<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cà phê Sữa Đá"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29,000 VND"
            android:textSize="16sp"
            android:textColor="@color/brown"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lightGray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kích cỡ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spSize"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/dark_brown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhiệt độ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spTemp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/brown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mức đá"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spIceLevel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/dark_brown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mức đường"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spSugarLevel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/dark_brown"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số lượng"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:inputType="number"
            android:hint="1"
            android:padding="8dp"
            android:background="@drawable/bg_edit_text"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghi chú (tùy chọn)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dark_brown"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Ví dụ: Ít ngọt, nhiều kem..."
            android:gravity="top|start"
            android:inputType="text"
            android:padding="8dp"
            android:background="@drawable/bg_edit_text"
            android:textColor="@color/dark_brown"
            android:textColorHint="@color/gray"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Thêm vào giỏ hàng"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="@color/brown" />

    </LinearLayout>
</ScrollView>