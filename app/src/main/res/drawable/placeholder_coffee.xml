<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nền xám nhạt -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EEEEEE" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Icon cốc cà phê đơn giản ở giữa -->
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="center">
        <vector
            android:width="80dp"
            android:height="80dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <!-- Cốc -->
            <path
                android:fillColor="#A1887F"
                android:pathData="M18,7H6C4.9,7 4,7.9 4,9v8c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V9C20,7.9 19.1,7 18,7z" />

            <!-- Nước cà phê bên trong -->
            <path
                android:fillColor="#5D4037"
                android:pathData="M6,9h12v6H6z" />

            <!-- Khói (3 đường cong nhỏ) -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#A1887F"
                android:strokeWidth="1.5"
                android:pathData="M9,5c0,-1.5 1,-2 1,-2s1,0.5 1,2" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#A1887F"
                android:strokeWidth="1.5"
                android:pathData="M12,5c0,-1.5 1,-2 1,-2s1,0.5 1,2" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#A1887F"
                android:strokeWidth="1.5"
                android:pathData="M15,5c0,-1.5 1,-2 1,-2s1,0.5 1,2" />
        </vector>
    </item>

</layer-list>