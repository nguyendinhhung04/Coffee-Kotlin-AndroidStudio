<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoffeeShop"
        tools:targetApi="31">

        <!-- Đặt LoginActivity làm màn hình khởi chạy -->
        <activity
            android:name=".ui.activity.LoginActivity"
            android:exported="true">
            <!-- DI CHUYỂN INTENT-FILTER VÀO ĐÂY -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Xóa intent-filter khỏi MainActivity và đặt exported="false" -->
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="false" />

        <!-- Các activity khác -->
        <activity
            android:name=".ui.activity.DrinkMenuActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activity.YourOrderActivity"
            android:exported="false" />

        <activity android:name=".ui.activity.OrderDetailActivity" />

        <activity
            android:name=".ui.activity.FavoritesActivity"
            android:exported="false" />

        <service android:name=".services.PushNotificationService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


    </application>

</manifest>
